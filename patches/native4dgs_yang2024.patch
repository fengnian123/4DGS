diff --git a/memory_offload.py b/memory_offload.py
new file mode 100644
--- /dev/null
+++ b/memory_offload.py
@@ -0,0 +1,45 @@
+"""Stage Adam moments in reusable pinned memory; keep the original GPU update."""
+import torch
+
+_buffers = {}
+
+
+@torch.no_grad()
+def move_adam_moments(optimizer, to_cpu):
+    moved = 0
+    devices = set()
+    for group_index, group in enumerate(optimizer.param_groups):
+        for parameter_index, parameter in enumerate(group['params']):
+            state = optimizer.state.get(parameter, {})
+            destination = torch.device('cpu') if to_cpu else parameter.device
+            for name in ('exp_avg', 'exp_avg_sq', 'max_exp_avg_sq'):
+                value = state.get(name)
+                if not torch.is_tensor(value) or value.device == destination:
+                    continue
+                if to_cpu:
+                    key = (id(optimizer), group_index, parameter_index, name)
+                    capacity = 1 << max(0, (value.numel()-1).bit_length())
+                    buffer = _buffers.get(key)
+                    if buffer is None or buffer.numel() < value.numel() or buffer.dtype != value.dtype:
+                        # Geometric capacities bound allocation churn as the model grows.
+                        buffer = torch.empty(capacity, dtype=value.dtype, device='cpu', pin_memory=True)
+                        _buffers[key] = buffer
+                    target = buffer[:value.numel()].view(value.shape)
+                    target.copy_(value, non_blocking=True)
+                else:
+                    target = value.to(destination, non_blocking=value.is_pinned())
+                state[name] = target
+                devices.add(parameter.device)
+                moved += value.numel() * value.element_size()
+    for device in devices:
+        torch.cuda.synchronize(device)
+    return moved
+
+
+def checkpoint_optimizer_state(optimizer):
+    """Serialize only used values, never spare pinned capacity or uninitialized bytes."""
+    original = optimizer.state_dict()
+    return dict(original, state={index: {
+        name: value.detach().clone() if torch.is_tensor(value) and value.device.type == 'cpu'
+        and value.untyped_storage().nbytes() > value.numel()*value.element_size() else value
+        for name, value in state.items()} for index, state in original['state'].items()})
